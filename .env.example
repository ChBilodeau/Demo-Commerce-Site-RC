# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored, so keys never get committed.
# Real values are backed up in 1Password (".env.local RC").
#
# NOTE: every VITE_* variable is inlined into the browser bundle. Only put
# public, query-only keys here (see SECURITY.md). Restart `npm run dev` after
# changing this file.

# ─── Core storefront (REQUIRED) ───────────────────────────────────────────────
# Anonymous search API key (query-only + analytics push). The app refuses to
# start without it.
VITE_COVEO_ACCESS_TOKEN=REPLACE_WITH_ANONYMOUS_SEARCH_API_KEY

# Storefront base URL used for analytics view.url AND product-listing page (PLP)
# URL resolution. The CMH listing pages are registered against this exact base,
# so keep it as-is or every listing page 404s. (Non-secret.)
VITE_STOREFRONT_BASE_URL=https://chbi-shop.example.com

# ─── Ask Coveo AI (Search Agent chat) ─────────────────────────────────────────
# API key allowed to call the Search Agent. API keys don't expire, unlike JWT
# search tokens (which caused daily 401s). Can be the same key as the CPD one.
VITE_COVEO_AGENT_TOKEN=REPLACE_WITH_AGENT_API_KEY

# ─── Try CPD! (Conversational Product Discovery) ──────────────────────────────
# "Anonymous search" API key with Execute agent queries + search + analytics.
VITE_COVEO_CPD_TOKEN=REPLACE_WITH_CPD_API_KEY

# ─── Technical Support (Case Assist + Salesforce Web-to-Case) ─────────────────
# Case Assist configuration GUID (Admin Console → Service → Case Assist).
VITE_COVEO_CASE_ASSIST_ID=REPLACE_WITH_CASE_ASSIST_CONFIG_ID
# Optional dedicated "Anonymous Case Assist" key; falls back to the access token.
VITE_COVEO_CASE_ASSIST_TOKEN=
# Classification fields the model predicts (Coveo field : display label).
VITE_COVEO_CASE_ASSIST_FIELDS=sfcasetype:Type,sfcasereason:Reason
# Optional Salesforce Web-to-Case org id (18 chars). Without it, submitting a
# case shows a local confirmation instead of creating a real Case.
VITE_SF_WEBTOCASE_ORGID=
# Web-to-Case field IDs (00N...) for the guided-funnel custom Case fields:
# Vehicle Category (picklist), Problem Type (picklist), Viewed Help Articles
# (checkbox). Find each id in Setup → Object Manager → Case → the field, or on
# the Web-to-Case HTML generator page. Needed for the funnel values to land on
# the Case; without them the funnel still works but those fields aren't submitted.
VITE_SF_FIELD_VEHICLE_CATEGORY=
VITE_SF_FIELD_PROBLEM_TYPE=
VITE_SF_FIELD_VIEWED_ARTICLES=

# ─── Debug logging (optional, leave false normally) ───────────────────────────
VITE_RECS_DEBUG=false
VITE_COVEO_CPD_DEBUG=false
VITE_COVEO_CASE_ASSIST_DEBUG=false
