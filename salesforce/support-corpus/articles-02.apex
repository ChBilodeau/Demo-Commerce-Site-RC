List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-car-perf-16','RC: Beginner guide: RC car motor runs too hot','Cars & Trucks / Performance & Tuning: The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?','<h2>RC car motor runs too hot</h2><p><b>Problem.</b> The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol>','Cars & Trucks','Performance & Tuning','<p>The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-perf-17','RC: Quick fix: RC car motor runs too hot','Cars & Trucks / Performance & Tuning: The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?','<h2>RC car motor runs too hot</h2><p><b>Problem.</b> The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol>','Cars & Trucks','Performance & Tuning','<p>The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-parts-18','RC: Choosing tires for your RC car surface','Cars & Trucks / Parts & Compatibility: I am not sure which tires to run on loose dirt versus pavement for my RC car.','<h2>Choosing tires for your RC car surface</h2><p><b>Problem.</b> I am not sure which tires to run on loose dirt versus pavement for my RC car.</p><p><b>Applies to.</b> Cars &amp; Trucks — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Soft compounds grip smooth or cold surfaces.</li><li>Pin or spike treads suit loose, dusty dirt.</li><li>Slicks and ribbed treads suit hard-packed or paved surfaces.</li><li>Match foam inserts to the tire and surface for support.</li></ol>','Cars & Trucks','Parts & Compatibility','<p>I am not sure which tires to run on loose dirt versus pavement for my RC car.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Soft compounds grip smooth or cold surfaces.</li><li>Pin or spike treads suit loose, dusty dirt.</li><li>Slicks and ribbed treads suit hard-packed or paved surfaces.</li><li>Match foam inserts to the tire and surface for support.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-parts-19','RC: Beginner guide: Choosing tires for your RC car surface','Cars & Trucks / Parts & Compatibility: I am not sure which tires to run on loose dirt versus pavement for my RC car.','<h2>Choosing tires for your RC car surface</h2><p><b>Problem.</b> I am not sure which tires to run on loose dirt versus pavement for my RC car.</p><p><b>Applies to.</b> Cars &amp; Trucks — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Soft compounds grip smooth or cold surfaces.</li><li>Pin or spike treads suit loose, dusty dirt.</li><li>Slicks and ribbed treads suit hard-packed or paved surfaces.</li><li>Match foam inserts to the tire and surface for support.</li></ol>','Cars & Trucks','Parts & Compatibility','<p>I am not sure which tires to run on loose dirt versus pavement for my RC car.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Soft compounds grip smooth or cold surfaces.</li><li>Pin or spike treads suit loose, dusty dirt.</li><li>Slicks and ribbed treads suit hard-packed or paved surfaces.</li><li>Match foam inserts to the tire and surface for support.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-warranty-20','RC: Warranty claim for a part that failed on an RC car','Cars & Trucks / Returns & Warranty: A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?','<h2>Warranty claim for a part that failed on an RC car</h2><p><b>Problem.</b> A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?</p><p><b>Applies to.</b> Cars &amp; Trucks — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Have your order number and a description of the failure ready.</li><li>Take clear photos of the failed part.</li><li>Note how many runs the part had and the conditions.</li><li>Submit the claim; normal wear and crash damage are typically not covered.</li></ol>','Cars & Trucks','Returns & Warranty','<p>A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Have your order number and a description of the failure ready.</li><li>Take clear photos of the failed part.</li><li>Note how many runs the part had and the conditions.</li><li>Submit the claim; normal wear and crash damage are typically not covered.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-warranty-21','RC: Beginner guide: Warranty claim for a part that failed on an RC car','Cars & Trucks / Returns & Warranty: A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?','<h2>Warranty claim for a part that failed on an RC car</h2><p><b>Problem.</b> A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?</p><p><b>Applies to.</b> Cars &amp; Trucks — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Have your order number and a description of the failure ready.</li><li>Take clear photos of the failed part.</li><li>Note how many runs the part had and the conditions.</li><li>Submit the claim; normal wear and crash damage are typically not covered.</li></ol>','Cars & Trucks','Returns & Warranty','<p>A gear snapped on the second run and I believe it is a defect. How do I start a warranty claim?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Have your order number and a description of the failure ready.</li><li>Take clear photos of the failed part.</li><li>Note how many runs the part had and the conditions.</li><li>Submit the claim; normal wear and crash damage are typically not covered.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-else-22','RC: Recommended spare parts for an RC car','Cars & Trucks / Something Else: What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?','<h2>Recommended spare parts for an RC car</h2><p><b>Problem.</b> What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Else.</p><p><b>Resolution.</b></p><ol><li>Keep spare spur gears, hinge pins, and driveshafts.</li><li>Stock a spare steering servo and a set of tires.</li><li>Carry common hardware, wheel nuts, and thread lock.</li><li>Keep shock oil and spare o-rings for quick rebuilds.</li></ol>','Cars & Trucks','Something Else','<p>What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?</p><p>This is a common <b>Something Else</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Keep spare spur gears, hinge pins, and driveshafts.</li><li>Stock a spare steering servo and a set of tires.</li><li>Carry common hardware, wheel nuts, and thread lock.</li><li>Keep shock oil and spare o-rings for quick rebuilds.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-else-23','RC: Beginner guide: Recommended spare parts for an RC car','Cars & Trucks / Something Else: What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?','<h2>Recommended spare parts for an RC car</h2><p><b>Problem.</b> What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Else.</p><p><b>Resolution.</b></p><ol><li>Keep spare spur gears, hinge pins, and driveshafts.</li><li>Stock a spare steering servo and a set of tires.</li><li>Carry common hardware, wheel nuts, and thread lock.</li><li>Keep shock oil and spare o-rings for quick rebuilds.</li></ol>','Cars & Trucks','Something Else','<p>What spare parts should I keep on hand for my 1/10 buggy so I am not stuck at the track?</p><p>This is a common <b>Something Else</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Keep spare spur gears, hinge pins, and driveshafts.</li><li>Stock a spare steering servo and a set of tires.</li><li>Carry common hardware, wheel nuts, and thread lock.</li><li>Keep shock oil and spare o-rings for quick rebuilds.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-setup-24','RC: Setting control surface throws on an RC plane','Airplanes / Setup & Getting Started: This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?','<h2>Setting control surface throws on an RC plane</h2><p><b>Problem.</b> This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p><b>Applies to.</b> Airplanes — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol>','Airplanes','Setup & Getting Started','<p>This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-setup-25','RC: Beginner guide: Setting control surface throws on an RC plane','Airplanes / Setup & Getting Started: This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?','<h2>Setting control surface throws on an RC plane</h2><p><b>Problem.</b> This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p><b>Applies to.</b> Airplanes — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol>','Airplanes','Setup & Getting Started','<p>This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-setup-26','RC: Quick fix: Setting control surface throws on an RC plane','Airplanes / Setup & Getting Started: This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?','<h2>Setting control surface throws on an RC plane</h2><p><b>Problem.</b> This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p><b>Applies to.</b> Airplanes — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol>','Airplanes','Setup & Getting Started','<p>This is my first RC plane. How do I set the aileron, elevator, and rudder throws and expo for a safe first flight?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set each surface to the manual&#x27;s recommended low-rate throw.</li><li>Add expo to soften the response near center.</li><li>Confirm every surface moves in the correct direction.</li><li>Double-check the center of gravity before flying.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-broken-27','RC: Repairing a cracked foam wing on an RC plane','Airplanes / Something Is Broken: The foam wing on my plane cracked near the root after a hard landing. What is the best repair?','<h2>Repairing a cracked foam wing on an RC plane</h2><p><b>Problem.</b> The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p><b>Applies to.</b> Airplanes — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol>','Airplanes','Something Is Broken','<p>The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p>This is a common <b>Something Is Broken</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-broken-28','RC: Beginner guide: Repairing a cracked foam wing on an RC plane','Airplanes / Something Is Broken: The foam wing on my plane cracked near the root after a hard landing. What is the best repair?','<h2>Repairing a cracked foam wing on an RC plane</h2><p><b>Problem.</b> The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p><b>Applies to.</b> Airplanes — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol>','Airplanes','Something Is Broken','<p>The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p>This is a common <b>Something Is Broken</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-broken-29','RC: Quick fix: Repairing a cracked foam wing on an RC plane','Airplanes / Something Is Broken: The foam wing on my plane cracked near the root after a hard landing. What is the best repair?','<h2>Repairing a cracked foam wing on an RC plane</h2><p><b>Problem.</b> The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p><b>Applies to.</b> Airplanes — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol>','Airplanes','Something Is Broken','<p>The foam wing on my plane cracked near the root after a hard landing. What is the best repair?</p><p>This is a common <b>Something Is Broken</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use foam-safe CA or epoxy for the bond.</li><li>Add a carbon or bamboo spar across the break for strength.</li><li>Clamp or tape until fully cured.</li><li>Re-balance the plane after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-perf-30','RC: RC plane will not hold altitude','Airplanes / Performance & Tuning: My trainer plane keeps losing height even at full throttle. The control surfaces look fine.','<h2>RC plane will not hold altitude</h2><p><b>Problem.</b> My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p><b>Applies to.</b> Airplanes — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol>','Airplanes','Performance & Tuning','<p>My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-perf-31','RC: Beginner guide: RC plane will not hold altitude','Airplanes / Performance & Tuning: My trainer plane keeps losing height even at full throttle. The control surfaces look fine.','<h2>RC plane will not hold altitude</h2><p><b>Problem.</b> My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p><b>Applies to.</b> Airplanes — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol>','Airplanes','Performance & Tuning','<p>My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-perf-32','RC: Quick fix: RC plane will not hold altitude','Airplanes / Performance & Tuning: My trainer plane keeps losing height even at full throttle. The control surfaces look fine.','<h2>RC plane will not hold altitude</h2><p><b>Problem.</b> My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p><b>Applies to.</b> Airplanes — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol>','Airplanes','Performance & Tuning','<p>My trainer plane keeps losing height even at full throttle. The control surfaces look fine.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the center of gravity is not tail-heavy.</li><li>Confirm control surfaces are centered and not drooping.</li><li>Verify the motor and prop produce the expected thrust.</li><li>Inspect for a warped wing or added weight.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 2/6: created '+created+' published '+published);
