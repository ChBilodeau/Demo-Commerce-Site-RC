/* articles-NN.apex (GENERATED) — tagged RC Knowledge articles.
 * Run each batch: sf apex run --target-org <your-org-alias> --file <file> */
// row: [slug, title, summary, bodyHtml, vehicleCategory, problemType, descriptionHtml, solutionHtml]
List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-car-setup-0','RC: Binding an RC car transmitter and receiver','Cars & Trucks / Setup & Getting Started: My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.','<h2>Binding an RC car transmitter and receiver</h2><p><b>Problem.</b> My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-setup-1','RC: Beginner guide: Binding an RC car transmitter and receiver','Cars & Trucks / Setup & Getting Started: My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.','<h2>Binding an RC car transmitter and receiver</h2><p><b>Problem.</b> My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-setup-2','RC: Quick fix: Binding an RC car transmitter and receiver','Cars & Trucks / Setup & Getting Started: My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.','<h2>Binding an RC car transmitter and receiver</h2><p><b>Problem.</b> My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>My new RC car transmitter will not bind to the receiver. The bind light keeps flashing and never goes solid.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Power the receiver and enter bind mode using the bind plug or button.</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, remove the bind plug, and power cycle both units.</li><li>If it still fails, confirm the transmitter and receiver use the same protocol and the batteries are charged.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-setup-3','RC: Calibrating the ESC throttle on an RC car','Cars & Trucks / Setup & Getting Started: The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.','<h2>Calibrating the ESC throttle on an RC car</h2><p><b>Problem.</b> The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-setup-4','RC: Beginner guide: Calibrating the ESC throttle on an RC car','Cars & Trucks / Setup & Getting Started: The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.','<h2>Calibrating the ESC throttle on an RC car</h2><p><b>Problem.</b> The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-setup-5','RC: Quick fix: Calibrating the ESC throttle on an RC car','Cars & Trucks / Setup & Getting Started: The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.','<h2>Calibrating the ESC throttle on an RC car</h2><p><b>Problem.</b> The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p><b>Applies to.</b> Cars &amp; Trucks — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol>','Cars & Trucks','Setup & Getting Started','<p>The ESC on my RC car keeps beeping and never arms. I think the throttle needs calibrating to the radio.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Turn the transmitter on first and set throttle trims to neutral.</li><li>Enter the ESC calibration mode per its manual (usually hold the set button while powering on).</li><li>Register full throttle, full brake, and neutral when prompted.</li><li>Power cycle and confirm the ESC arms with its normal tones.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-6','RC: Grinding noise and a stripped spur gear on an RC car','Cars & Trucks / Something Is Broken: There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.','<h2>Grinding noise and a stripped spur gear on an RC car</h2><p><b>Problem.</b> There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol>','Cars & Trucks','Something Is Broken','<p>There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-7','RC: Beginner guide: Grinding noise and a stripped spur gear on an RC car','Cars & Trucks / Something Is Broken: There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.','<h2>Grinding noise and a stripped spur gear on an RC car</h2><p><b>Problem.</b> There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol>','Cars & Trucks','Something Is Broken','<p>There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-8','RC: Quick fix: Grinding noise and a stripped spur gear on an RC car','Cars & Trucks / Something Is Broken: There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.','<h2>Grinding noise and a stripped spur gear on an RC car</h2><p><b>Problem.</b> There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol>','Cars & Trucks','Something Is Broken','<p>There is a loud grinding noise from the gearbox and the car lurches. I suspect a stripped spur gear.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect the spur and pinion for rounded or missing teeth.</li><li>Replace the stripped gear.</li><li>Reset the gear mesh using the paper method so there is slight backlash.</li><li>Tighten the motor screws so the mesh stays correct.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-9','RC: Steering dead after a crash on an RC car','Cars & Trucks / Something Is Broken: After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.','<h2>Steering dead after a crash on an RC car</h2><p><b>Problem.</b> After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol>','Cars & Trucks','Something Is Broken','<p>After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-10','RC: Beginner guide: Steering dead after a crash on an RC car','Cars & Trucks / Something Is Broken: After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.','<h2>Steering dead after a crash on an RC car</h2><p><b>Problem.</b> After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol>','Cars & Trucks','Something Is Broken','<p>After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-broken-11','RC: Quick fix: Steering dead after a crash on an RC car','Cars & Trucks / Something Is Broken: After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.','<h2>Steering dead after a crash on an RC car</h2><p><b>Problem.</b> After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p><b>Applies to.</b> Cars &amp; Trucks — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol>','Cars & Trucks','Something Is Broken','<p>After hitting a curb the steering is dead and I hear grinding. I think the servo gears are stripped.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Grinding with no movement usually means stripped servo gears.</li><li>Replace the servo gear set, or the whole servo.</li><li>Fit a quality servo saver to absorb future impacts.</li><li>Re-center the steering and check endpoints after the repair.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-perf-12','RC: Reducing on-power oversteer on an RC car','Cars & Trucks / Performance & Tuning: My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?','<h2>Reducing on-power oversteer on an RC car</h2><p><b>Problem.</b> My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol>','Cars & Trucks','Performance & Tuning','<p>My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-perf-13','RC: Beginner guide: Reducing on-power oversteer on an RC car','Cars & Trucks / Performance & Tuning: My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?','<h2>Reducing on-power oversteer on an RC car</h2><p><b>Problem.</b> My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol>','Cars & Trucks','Performance & Tuning','<p>My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-perf-14','RC: Quick fix: Reducing on-power oversteer on an RC car','Cars & Trucks / Performance & Tuning: My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?','<h2>Reducing on-power oversteer on an RC car</h2><p><b>Problem.</b> My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol>','Cars & Trucks','Performance & Tuning','<p>My buggy snaps loose and the rear steps out when I get on the throttle. How do I reduce on-power oversteer?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Use a thicker rear differential oil to smooth power delivery.</li><li>Soften the rear springs or stiffen the front.</li><li>Add rear toe-in for stability.</li><li>Apply throttle more smoothly out of corners.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-car-perf-15','RC: RC car motor runs too hot','Cars & Trucks / Performance & Tuning: The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?','<h2>RC car motor runs too hot</h2><p><b>Problem.</b> The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p><b>Applies to.</b> Cars &amp; Trucks — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol>','Cars & Trucks','Performance & Tuning','<p>The motor on my truck gets very hot after a few minutes and the car slows down. How do I keep temperatures down?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Cars &amp; Trucks</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reduce the pinion gear by a tooth or two to lower the load.</li><li>Improve airflow or add a cooling fan to the motor and ESC.</li><li>Confirm the drivetrain spins freely with no binding.</li><li>Avoid prolonged full-throttle runs in high-traction conditions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 1/6: created '+created+' published '+published);
