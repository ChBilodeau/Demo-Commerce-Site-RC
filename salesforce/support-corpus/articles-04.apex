/* articles-NN.apex (GENERATED) — tagged RC Knowledge articles.
 * Run each batch: sf apex run --target-org <your-org-alias> --file <file> */
// row: [slug, title, summary, bodyHtml, vehicleCategory, problemType, descriptionHtml, solutionHtml]
List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-heli-warranty-51','RC: Beginner guide: Warranty claim for a defective RC helicopter part','Helicopters / Returns & Warranty: A part on my heli failed and I think it is defective. How do I claim warranty?','<h2>Warranty claim for a defective RC helicopter part</h2><p><b>Problem.</b> A part on my heli failed and I think it is defective. How do I claim warranty?</p><p><b>Applies to.</b> Helicopters — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos of the part.</li><li>Describe when and how the failure happened.</li><li>Normal wear from flights is not covered.</li><li>Submit the claim with the run count.</li></ol>','Helicopters','Returns & Warranty','<p>A part on my heli failed and I think it is defective. How do I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos of the part.</li><li>Describe when and how the failure happened.</li><li>Normal wear from flights is not covered.</li><li>Submit the claim with the run count.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-else-52','RC: Recommended tools and spares for RC helicopters','Helicopters / Something Else: What tools and spares should I keep for my RC helicopter?','<h2>Recommended tools and spares for RC helicopters</h2><p><b>Problem.</b> What tools and spares should I keep for my RC helicopter?</p><p><b>Applies to.</b> Helicopters — Something Else.</p><p><b>Resolution.</b></p><ol><li>Keep spare main blades and a main gear.</li><li>Carry metric hex drivers and a blade balancer.</li><li>Stock spare linkage balls and a tail belt if applicable.</li><li>Keep thread lock for rotor hardware.</li></ol>','Helicopters','Something Else','<p>What tools and spares should I keep for my RC helicopter?</p><p>This is a common <b>Something Else</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Keep spare main blades and a main gear.</li><li>Carry metric hex drivers and a blade balancer.</li><li>Stock spare linkage balls and a tail belt if applicable.</li><li>Keep thread lock for rotor hardware.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-else-53','RC: Beginner guide: Recommended tools and spares for RC helicopters','Helicopters / Something Else: What tools and spares should I keep for my RC helicopter?','<h2>Recommended tools and spares for RC helicopters</h2><p><b>Problem.</b> What tools and spares should I keep for my RC helicopter?</p><p><b>Applies to.</b> Helicopters — Something Else.</p><p><b>Resolution.</b></p><ol><li>Keep spare main blades and a main gear.</li><li>Carry metric hex drivers and a blade balancer.</li><li>Stock spare linkage balls and a tail belt if applicable.</li><li>Keep thread lock for rotor hardware.</li></ol>','Helicopters','Something Else','<p>What tools and spares should I keep for my RC helicopter?</p><p>This is a common <b>Something Else</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Keep spare main blades and a main gear.</li><li>Carry metric hex drivers and a blade balancer.</li><li>Stock spare linkage balls and a tail belt if applicable.</li><li>Keep thread lock for rotor hardware.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-setup-54','RC: Waterproofing an RC boat before launch','Boats / Setup & Getting Started: I want to make sure my RC boat does not leak before the first run. What should I seal?','<h2>Waterproofing an RC boat before launch</h2><p><b>Problem.</b> I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p><b>Applies to.</b> Boats — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol>','Boats','Setup & Getting Started','<p>I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-setup-55','RC: Beginner guide: Waterproofing an RC boat before launch','Boats / Setup & Getting Started: I want to make sure my RC boat does not leak before the first run. What should I seal?','<h2>Waterproofing an RC boat before launch</h2><p><b>Problem.</b> I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p><b>Applies to.</b> Boats — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol>','Boats','Setup & Getting Started','<p>I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-setup-56','RC: Quick fix: Waterproofing an RC boat before launch','Boats / Setup & Getting Started: I want to make sure my RC boat does not leak before the first run. What should I seal?','<h2>Waterproofing an RC boat before launch</h2><p><b>Problem.</b> I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p><b>Applies to.</b> Boats — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol>','Boats','Setup & Getting Started','<p>I want to make sure my RC boat does not leak before the first run. What should I seal?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Reseal the hatch with a fresh gasket.</li><li>Silicone the stuffing tube and all wire exits.</li><li>Bag or coat the receiver and ESC.</li><li>Float-test on calm water before a full run.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-broken-57','RC: RC boat is taking on water','Boats / Something Is Broken: Water is getting inside the hull of my RC boat and soaking the electronics.','<h2>RC boat is taking on water</h2><p><b>Problem.</b> Water is getting inside the hull of my RC boat and soaking the electronics.</p><p><b>Applies to.</b> Boats — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol>','Boats','Something Is Broken','<p>Water is getting inside the hull of my RC boat and soaking the electronics.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-broken-58','RC: Beginner guide: RC boat is taking on water','Boats / Something Is Broken: Water is getting inside the hull of my RC boat and soaking the electronics.','<h2>RC boat is taking on water</h2><p><b>Problem.</b> Water is getting inside the hull of my RC boat and soaking the electronics.</p><p><b>Applies to.</b> Boats — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol>','Boats','Something Is Broken','<p>Water is getting inside the hull of my RC boat and soaking the electronics.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-broken-59','RC: Quick fix: RC boat is taking on water','Boats / Something Is Broken: Water is getting inside the hull of my RC boat and soaking the electronics.','<h2>RC boat is taking on water</h2><p><b>Problem.</b> Water is getting inside the hull of my RC boat and soaking the electronics.</p><p><b>Applies to.</b> Boats — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol>','Boats','Something Is Broken','<p>Water is getting inside the hull of my RC boat and soaking the electronics.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Find the leak with a short dry-run on the water.</li><li>Reseal the hatch gasket and the tube exits.</li><li>Dry the electronics fully and protect them.</li><li>Add a bilge sponge for peace of mind.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-perf-60','RC: RC boat will not get up on plane','Boats / Performance & Tuning: My boat plows through the water and will not plane. What should I change?','<h2>RC boat will not get up on plane</h2><p><b>Problem.</b> My boat plows through the water and will not plane. What should I change?</p><p><b>Applies to.</b> Boats — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol>','Boats','Performance & Tuning','<p>My boat plows through the water and will not plane. What should I change?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-perf-61','RC: Beginner guide: RC boat will not get up on plane','Boats / Performance & Tuning: My boat plows through the water and will not plane. What should I change?','<h2>RC boat will not get up on plane</h2><p><b>Problem.</b> My boat plows through the water and will not plane. What should I change?</p><p><b>Applies to.</b> Boats — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol>','Boats','Performance & Tuning','<p>My boat plows through the water and will not plane. What should I change?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-perf-62','RC: Quick fix: RC boat will not get up on plane','Boats / Performance & Tuning: My boat plows through the water and will not plane. What should I change?','<h2>RC boat will not get up on plane</h2><p><b>Problem.</b> My boat plows through the water and will not plane. What should I change?</p><p><b>Applies to.</b> Boats — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol>','Boats','Performance & Tuning','<p>My boat plows through the water and will not plane. What should I change?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the propeller size and condition.</li><li>Adjust the strut and trim angle.</li><li>Reduce unnecessary weight in the hull.</li><li>Confirm the motor reaches full RPM.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-parts-63','RC: Choosing a replacement prop for an RC boat','Boats / Parts & Compatibility: I need a new prop for my RC boat. How do I pick the right one?','<h2>Choosing a replacement prop for an RC boat</h2><p><b>Problem.</b> I need a new prop for my RC boat. How do I pick the right one?</p><p><b>Applies to.</b> Boats — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the propeller to the hull size and motor.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction.</li><li>Start with the stock size before experimenting.</li></ol>','Boats','Parts & Compatibility','<p>I need a new prop for my RC boat. How do I pick the right one?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the propeller to the hull size and motor.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction.</li><li>Start with the stock size before experimenting.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-parts-64','RC: Beginner guide: Choosing a replacement prop for an RC boat','Boats / Parts & Compatibility: I need a new prop for my RC boat. How do I pick the right one?','<h2>Choosing a replacement prop for an RC boat</h2><p><b>Problem.</b> I need a new prop for my RC boat. How do I pick the right one?</p><p><b>Applies to.</b> Boats — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the propeller to the hull size and motor.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction.</li><li>Start with the stock size before experimenting.</li></ol>','Boats','Parts & Compatibility','<p>I need a new prop for my RC boat. How do I pick the right one?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the propeller to the hull size and motor.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction.</li><li>Start with the stock size before experimenting.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-warranty-65','RC: Warranty for a water-damaged RC boat ESC','Boats / Returns & Warranty: The ESC in my boat got water-damaged. Is this covered by warranty?','<h2>Warranty for a water-damaged RC boat ESC</h2><p><b>Problem.</b> The ESC in my boat got water-damaged. Is this covered by warranty?</p><p><b>Applies to.</b> Boats — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the conditions of the run.</li><li>Water intrusion from an unsealed hull is typically not covered.</li><li>Submit the claim for review.</li></ol>','Boats','Returns & Warranty','<p>The ESC in my boat got water-damaged. Is this covered by warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the conditions of the run.</li><li>Water intrusion from an unsealed hull is typically not covered.</li><li>Submit the claim for review.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-warranty-66','RC: Beginner guide: Warranty for a water-damaged RC boat ESC','Boats / Returns & Warranty: The ESC in my boat got water-damaged. Is this covered by warranty?','<h2>Warranty for a water-damaged RC boat ESC</h2><p><b>Problem.</b> The ESC in my boat got water-damaged. Is this covered by warranty?</p><p><b>Applies to.</b> Boats — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the conditions of the run.</li><li>Water intrusion from an unsealed hull is typically not covered.</li><li>Submit the claim for review.</li></ol>','Boats','Returns & Warranty','<p>The ESC in my boat got water-damaged. Is this covered by warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the conditions of the run.</li><li>Water intrusion from an unsealed hull is typically not covered.</li><li>Submit the claim for review.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-else-67','RC: Post-run care for an RC boat','Boats / Something Else: How should I care for my RC boat after running in dirty or salt water?','<h2>Post-run care for an RC boat</h2><p><b>Problem.</b> How should I care for my RC boat after running in dirty or salt water?</p><p><b>Applies to.</b> Boats — Something Else.</p><p><b>Resolution.</b></p><ol><li>Rinse the boat with fresh water and dry it.</li><li>Re-grease the drive and seals.</li><li>Check the electronics bay for moisture.</li><li>Store with the hatch off so it dries fully.</li></ol>','Boats','Something Else','<p>How should I care for my RC boat after running in dirty or salt water?</p><p>This is a common <b>Something Else</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Rinse the boat with fresh water and dry it.</li><li>Re-grease the drive and seals.</li><li>Check the electronics bay for moisture.</li><li>Store with the hatch off so it dries fully.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-boat-else-68','RC: Beginner guide: Post-run care for an RC boat','Boats / Something Else: How should I care for my RC boat after running in dirty or salt water?','<h2>Post-run care for an RC boat</h2><p><b>Problem.</b> How should I care for my RC boat after running in dirty or salt water?</p><p><b>Applies to.</b> Boats — Something Else.</p><p><b>Resolution.</b></p><ol><li>Rinse the boat with fresh water and dry it.</li><li>Re-grease the drive and seals.</li><li>Check the electronics bay for moisture.</li><li>Store with the hatch off so it dries fully.</li></ol>','Boats','Something Else','<p>How should I care for my RC boat after running in dirty or salt water?</p><p>This is a common <b>Something Else</b> issue for <b>Boats</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Rinse the boat with fresh water and dry it.</li><li>Re-grease the drive and seals.</li><li>Check the electronics bay for moisture.</li><li>Store with the hatch off so it dries fully.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-setup-69','RC: Binding FPV goggles to a drone VTX','Drones / Setup & Getting Started: I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?','<h2>Binding FPV goggles to a drone VTX</h2><p><b>Problem.</b> I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p><b>Applies to.</b> Drones — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol>','Drones','Setup & Getting Started','<p>I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-setup-70','RC: Beginner guide: Binding FPV goggles to a drone VTX','Drones / Setup & Getting Started: I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?','<h2>Binding FPV goggles to a drone VTX</h2><p><b>Problem.</b> I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p><b>Applies to.</b> Drones — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol>','Drones','Setup & Getting Started','<p>I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 4/6: created '+created+' published '+published);
