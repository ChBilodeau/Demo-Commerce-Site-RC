/* articles-NN.apex (GENERATED) — tagged RC Knowledge articles.
 * Run each batch: sf apex run --target-org VSCodePlayground --file <file> */
// row: [slug, title, summary, bodyHtml, vehicleCategory, problemType, descriptionHtml, solutionHtml]
List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-gen-perf-90','RC: Battery runtime dropped and the pack runs hot','Other / Performance & Tuning: My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.','<h2>Battery runtime dropped and the pack runs hot</h2><p><b>Problem.</b> My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p><b>Applies to.</b> Other — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol>','Other','Performance & Tuning','<p>My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-perf-91','RC: Beginner guide: Battery runtime dropped and the pack runs hot','Other / Performance & Tuning: My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.','<h2>Battery runtime dropped and the pack runs hot</h2><p><b>Problem.</b> My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p><b>Applies to.</b> Other — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol>','Other','Performance & Tuning','<p>My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-perf-92','RC: Quick fix: Battery runtime dropped and the pack runs hot','Other / Performance & Tuning: My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.','<h2>Battery runtime dropped and the pack runs hot</h2><p><b>Problem.</b> My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p><b>Applies to.</b> Other — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol>','Other','Performance & Tuning','<p>My fully charged pack only lasts a few minutes and gets hot. It used to last much longer.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the cell internal resistance for aging.</li><li>Avoid over-gearing that forces high current.</li><li>Confirm the motor and ESC are not dragging.</li><li>Replace a pack that is past its service life.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-parts-93','RC: Matching battery connectors to the ESC','Other / Parts & Compatibility: My new pack has a different connector than my ESC. What are my options?','<h2>Matching battery connectors to the ESC</h2><p><b>Problem.</b> My new pack has a different connector than my ESC. What are my options?</p><p><b>Applies to.</b> Other — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Identify both connector types (XT60, XT90, EC5, Deans).</li><li>Use an adapter or solder a matching connector.</li><li>Keep polarity correct when soldering.</li><li>Use heat shrink to insulate the joint.</li></ol>','Other','Parts & Compatibility','<p>My new pack has a different connector than my ESC. What are my options?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Identify both connector types (XT60, XT90, EC5, Deans).</li><li>Use an adapter or solder a matching connector.</li><li>Keep polarity correct when soldering.</li><li>Use heat shrink to insulate the joint.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-parts-94','RC: Beginner guide: Matching battery connectors to the ESC','Other / Parts & Compatibility: My new pack has a different connector than my ESC. What are my options?','<h2>Matching battery connectors to the ESC</h2><p><b>Problem.</b> My new pack has a different connector than my ESC. What are my options?</p><p><b>Applies to.</b> Other — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Identify both connector types (XT60, XT90, EC5, Deans).</li><li>Use an adapter or solder a matching connector.</li><li>Keep polarity correct when soldering.</li><li>Use heat shrink to insulate the joint.</li></ol>','Other','Parts & Compatibility','<p>My new pack has a different connector than my ESC. What are my options?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Identify both connector types (XT60, XT90, EC5, Deans).</li><li>Use an adapter or solder a matching connector.</li><li>Keep polarity correct when soldering.</li><li>Use heat shrink to insulate the joint.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-warranty-95','RC: Warranty on a charger or accessory','Other / Returns & Warranty: My charger stopped working. How do I handle a warranty claim?','<h2>Warranty on a charger or accessory</h2><p><b>Problem.</b> My charger stopped working. How do I handle a warranty claim?</p><p><b>Applies to.</b> Other — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the fault and when it started.</li><li>Keep the original packaging if possible.</li><li>Submit the claim for review.</li></ol>','Other','Returns & Warranty','<p>My charger stopped working. How do I handle a warranty claim?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the fault and when it started.</li><li>Keep the original packaging if possible.</li><li>Submit the claim for review.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-warranty-96','RC: Beginner guide: Warranty on a charger or accessory','Other / Returns & Warranty: My charger stopped working. How do I handle a warranty claim?','<h2>Warranty on a charger or accessory</h2><p><b>Problem.</b> My charger stopped working. How do I handle a warranty claim?</p><p><b>Applies to.</b> Other — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the fault and when it started.</li><li>Keep the original packaging if possible.</li><li>Submit the claim for review.</li></ol>','Other','Returns & Warranty','<p>My charger stopped working. How do I handle a warranty claim?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the fault and when it started.</li><li>Keep the original packaging if possible.</li><li>Submit the claim for review.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-else-97','RC: Best way to store LiPo packs','Other / Something Else: How should I store my LiPo packs between sessions so they stay healthy?','<h2>Best way to store LiPo packs</h2><p><b>Problem.</b> How should I store my LiPo packs between sessions so they stay healthy?</p><p><b>Applies to.</b> Other — Something Else.</p><p><b>Resolution.</b></p><ol><li>Store at about 3.8V per cell (storage voltage).</li><li>Keep them cool, dry, and in a fireproof container.</li><li>Avoid leaving packs fully charged for long periods.</li><li>Check voltage periodically during storage.</li></ol>','Other','Something Else','<p>How should I store my LiPo packs between sessions so they stay healthy?</p><p>This is a common <b>Something Else</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Store at about 3.8V per cell (storage voltage).</li><li>Keep them cool, dry, and in a fireproof container.</li><li>Avoid leaving packs fully charged for long periods.</li><li>Check voltage periodically during storage.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-else-98','RC: Beginner guide: Best way to store LiPo packs','Other / Something Else: How should I store my LiPo packs between sessions so they stay healthy?','<h2>Best way to store LiPo packs</h2><p><b>Problem.</b> How should I store my LiPo packs between sessions so they stay healthy?</p><p><b>Applies to.</b> Other — Something Else.</p><p><b>Resolution.</b></p><ol><li>Store at about 3.8V per cell (storage voltage).</li><li>Keep them cool, dry, and in a fireproof container.</li><li>Avoid leaving packs fully charged for long periods.</li><li>Check voltage periodically during storage.</li></ol>','Other','Something Else','<p>How should I store my LiPo packs between sessions so they stay healthy?</p><p>This is a common <b>Something Else</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Store at about 3.8V per cell (storage voltage).</li><li>Keep them cool, dry, and in a fireproof container.</li><li>Avoid leaving packs fully charged for long periods.</li><li>Check voltage periodically during storage.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 6/6: created '+created+' published '+published);
