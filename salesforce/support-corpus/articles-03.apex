List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-air-parts-33','RC: Choosing a replacement propeller for an RC plane','Airplanes / Parts & Compatibility: I need a new propeller for my plane but I am not sure which size fits my motor.','<h2>Choosing a replacement propeller for an RC plane</h2><p><b>Problem.</b> I need a new propeller for my plane but I am not sure which size fits my motor.</p><p><b>Applies to.</b> Airplanes — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the propeller diameter and pitch to the motor and ESC rating.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction matches the motor.</li><li>Use a locking collet or nut so it stays tight.</li></ol>','Airplanes','Parts & Compatibility','<p>I need a new propeller for my plane but I am not sure which size fits my motor.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the propeller diameter and pitch to the motor and ESC rating.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction matches the motor.</li><li>Use a locking collet or nut so it stays tight.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-parts-34','RC: Beginner guide: Choosing a replacement propeller for an RC plane','Airplanes / Parts & Compatibility: I need a new propeller for my plane but I am not sure which size fits my motor.','<h2>Choosing a replacement propeller for an RC plane</h2><p><b>Problem.</b> I need a new propeller for my plane but I am not sure which size fits my motor.</p><p><b>Applies to.</b> Airplanes — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the propeller diameter and pitch to the motor and ESC rating.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction matches the motor.</li><li>Use a locking collet or nut so it stays tight.</li></ol>','Airplanes','Parts & Compatibility','<p>I need a new propeller for my plane but I am not sure which size fits my motor.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the propeller diameter and pitch to the motor and ESC rating.</li><li>Balance the prop to reduce vibration.</li><li>Confirm the rotation direction matches the motor.</li><li>Use a locking collet or nut so it stays tight.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-warranty-35','RC: Warranty on an RC plane motor that failed early','Airplanes / Returns & Warranty: The motor on my plane failed after a few flights. Can I claim warranty?','<h2>Warranty on an RC plane motor that failed early</h2><p><b>Problem.</b> The motor on my plane failed after a few flights. Can I claim warranty?</p><p><b>Applies to.</b> Airplanes — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and the flight count.</li><li>Describe the failure and include photos.</li><li>Note the conditions of the flights.</li><li>Crash damage is typically not covered.</li></ol>','Airplanes','Returns & Warranty','<p>The motor on my plane failed after a few flights. Can I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and the flight count.</li><li>Describe the failure and include photos.</li><li>Note the conditions of the flights.</li><li>Crash damage is typically not covered.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-warranty-36','RC: Beginner guide: Warranty on an RC plane motor that failed early','Airplanes / Returns & Warranty: The motor on my plane failed after a few flights. Can I claim warranty?','<h2>Warranty on an RC plane motor that failed early</h2><p><b>Problem.</b> The motor on my plane failed after a few flights. Can I claim warranty?</p><p><b>Applies to.</b> Airplanes — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and the flight count.</li><li>Describe the failure and include photos.</li><li>Note the conditions of the flights.</li><li>Crash damage is typically not covered.</li></ol>','Airplanes','Returns & Warranty','<p>The motor on my plane failed after a few flights. Can I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and the flight count.</li><li>Describe the failure and include photos.</li><li>Note the conditions of the flights.</li><li>Crash damage is typically not covered.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-else-37','RC: Pre-flight safety checklist for an RC plane','Airplanes / Something Else: What should I check before every flight with my RC plane?','<h2>Pre-flight safety checklist for an RC plane</h2><p><b>Problem.</b> What should I check before every flight with my RC plane?</p><p><b>Applies to.</b> Airplanes — Something Else.</p><p><b>Resolution.</b></p><ol><li>Range-check the radio before takeoff.</li><li>Confirm the battery is charged and secured.</li><li>Check all control surfaces and linkages are tight.</li><li>Verify failsafe stops the motor on signal loss.</li></ol>','Airplanes','Something Else','<p>What should I check before every flight with my RC plane?</p><p>This is a common <b>Something Else</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Range-check the radio before takeoff.</li><li>Confirm the battery is charged and secured.</li><li>Check all control surfaces and linkages are tight.</li><li>Verify failsafe stops the motor on signal loss.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-air-else-38','RC: Beginner guide: Pre-flight safety checklist for an RC plane','Airplanes / Something Else: What should I check before every flight with my RC plane?','<h2>Pre-flight safety checklist for an RC plane</h2><p><b>Problem.</b> What should I check before every flight with my RC plane?</p><p><b>Applies to.</b> Airplanes — Something Else.</p><p><b>Resolution.</b></p><ol><li>Range-check the radio before takeoff.</li><li>Confirm the battery is charged and secured.</li><li>Check all control surfaces and linkages are tight.</li><li>Verify failsafe stops the motor on signal loss.</li></ol>','Airplanes','Something Else','<p>What should I check before every flight with my RC plane?</p><p>This is a common <b>Something Else</b> issue for <b>Airplanes</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Range-check the radio before takeoff.</li><li>Confirm the battery is charged and secured.</li><li>Check all control surfaces and linkages are tight.</li><li>Verify failsafe stops the motor on signal loss.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-setup-39','RC: Leveling the swashplate on an RC helicopter','Helicopters / Setup & Getting Started: I am new to helis and need to level the swashplate and set collective pitch. How do I start?','<h2>Leveling the swashplate on an RC helicopter</h2><p><b>Problem.</b> I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p><b>Applies to.</b> Helicopters — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol>','Helicopters','Setup & Getting Started','<p>I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-setup-40','RC: Beginner guide: Leveling the swashplate on an RC helicopter','Helicopters / Setup & Getting Started: I am new to helis and need to level the swashplate and set collective pitch. How do I start?','<h2>Leveling the swashplate on an RC helicopter</h2><p><b>Problem.</b> I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p><b>Applies to.</b> Helicopters — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol>','Helicopters','Setup & Getting Started','<p>I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-setup-41','RC: Quick fix: Leveling the swashplate on an RC helicopter','Helicopters / Setup & Getting Started: I am new to helis and need to level the swashplate and set collective pitch. How do I start?','<h2>Leveling the swashplate on an RC helicopter</h2><p><b>Problem.</b> I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p><b>Applies to.</b> Helicopters — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol>','Helicopters','Setup & Getting Started','<p>I am new to helis and need to level the swashplate and set collective pitch. How do I start?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Center all trims and sub-trims first.</li><li>Adjust the linkages so the swashplate sits level.</li><li>Set the collective pitch range per the manual.</li><li>Verify cyclic movements are even in all directions.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-broken-42','RC: Main gear stripped after a crash on an RC helicopter','Helicopters / Something Is Broken: After a tip-over the main gear is stripped and the heli will not spool up.','<h2>Main gear stripped after a crash on an RC helicopter</h2><p><b>Problem.</b> After a tip-over the main gear is stripped and the heli will not spool up.</p><p><b>Applies to.</b> Helicopters — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol>','Helicopters','Something Is Broken','<p>After a tip-over the main gear is stripped and the heli will not spool up.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-broken-43','RC: Beginner guide: Main gear stripped after a crash on an RC helicopter','Helicopters / Something Is Broken: After a tip-over the main gear is stripped and the heli will not spool up.','<h2>Main gear stripped after a crash on an RC helicopter</h2><p><b>Problem.</b> After a tip-over the main gear is stripped and the heli will not spool up.</p><p><b>Applies to.</b> Helicopters — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol>','Helicopters','Something Is Broken','<p>After a tip-over the main gear is stripped and the heli will not spool up.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-broken-44','RC: Quick fix: Main gear stripped after a crash on an RC helicopter','Helicopters / Something Is Broken: After a tip-over the main gear is stripped and the heli will not spool up.','<h2>Main gear stripped after a crash on an RC helicopter</h2><p><b>Problem.</b> After a tip-over the main gear is stripped and the heli will not spool up.</p><p><b>Applies to.</b> Helicopters — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol>','Helicopters','Something Is Broken','<p>After a tip-over the main gear is stripped and the heli will not spool up.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Replace the stripped main gear.</li><li>Check the pinion mesh after fitting the new gear.</li><li>Inspect the one-way bearing for damage.</li><li>Spin the head by hand to confirm smooth engagement.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-perf-45','RC: RC helicopter vibrates badly in hover','Helicopters / Performance & Tuning: My heli shakes a lot in hover and the tail wags. I think the blades need tracking.','<h2>RC helicopter vibrates badly in hover</h2><p><b>Problem.</b> My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p><b>Applies to.</b> Helicopters — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol>','Helicopters','Performance & Tuning','<p>My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-perf-46','RC: Beginner guide: RC helicopter vibrates badly in hover','Helicopters / Performance & Tuning: My heli shakes a lot in hover and the tail wags. I think the blades need tracking.','<h2>RC helicopter vibrates badly in hover</h2><p><b>Problem.</b> My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p><b>Applies to.</b> Helicopters — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol>','Helicopters','Performance & Tuning','<p>My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-perf-47','RC: Quick fix: RC helicopter vibrates badly in hover','Helicopters / Performance & Tuning: My heli shakes a lot in hover and the tail wags. I think the blades need tracking.','<h2>RC helicopter vibrates badly in hover</h2><p><b>Problem.</b> My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p><b>Applies to.</b> Helicopters — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol>','Helicopters','Performance & Tuning','<p>My heli shakes a lot in hover and the tail wags. I think the blades need tracking.</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Track the main blades using colored tape to see which is high.</li><li>Adjust linkage length to bring the blades into track.</li><li>Balance the blades before flight.</li><li>Check for a bent shaft or loose blade grips.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-parts-48','RC: Choosing replacement main blades for an RC helicopter','Helicopters / Parts & Compatibility: I need new main blades for my heli but I am not sure what fits.','<h2>Choosing replacement main blades for an RC helicopter</h2><p><b>Problem.</b> I need new main blades for my heli but I am not sure what fits.</p><p><b>Applies to.</b> Helicopters — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the blade length to your helicopter class.</li><li>Replace both blades as a matched set.</li><li>Balance the new blades before flying.</li><li>Confirm the root bolt size matches the grips.</li></ol>','Helicopters','Parts & Compatibility','<p>I need new main blades for my heli but I am not sure what fits.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the blade length to your helicopter class.</li><li>Replace both blades as a matched set.</li><li>Balance the new blades before flying.</li><li>Confirm the root bolt size matches the grips.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-parts-49','RC: Beginner guide: Choosing replacement main blades for an RC helicopter','Helicopters / Parts & Compatibility: I need new main blades for my heli but I am not sure what fits.','<h2>Choosing replacement main blades for an RC helicopter</h2><p><b>Problem.</b> I need new main blades for my heli but I am not sure what fits.</p><p><b>Applies to.</b> Helicopters — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the blade length to your helicopter class.</li><li>Replace both blades as a matched set.</li><li>Balance the new blades before flying.</li><li>Confirm the root bolt size matches the grips.</li></ol>','Helicopters','Parts & Compatibility','<p>I need new main blades for my heli but I am not sure what fits.</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the blade length to your helicopter class.</li><li>Replace both blades as a matched set.</li><li>Balance the new blades before flying.</li><li>Confirm the root bolt size matches the grips.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-heli-warranty-50','RC: Warranty claim for a defective RC helicopter part','Helicopters / Returns & Warranty: A part on my heli failed and I think it is defective. How do I claim warranty?','<h2>Warranty claim for a defective RC helicopter part</h2><p><b>Problem.</b> A part on my heli failed and I think it is defective. How do I claim warranty?</p><p><b>Applies to.</b> Helicopters — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos of the part.</li><li>Describe when and how the failure happened.</li><li>Normal wear from flights is not covered.</li><li>Submit the claim with the run count.</li></ol>','Helicopters','Returns & Warranty','<p>A part on my heli failed and I think it is defective. How do I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Helicopters</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos of the part.</li><li>Describe when and how the failure happened.</li><li>Normal wear from flights is not covered.</li><li>Submit the claim with the run count.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 3/6: created '+created+' published '+published);
