// row: [slug, title, summary, bodyHtml, vehicleCategory, problemType, descriptionHtml, solutionHtml]
List<List<String>> rows = new List<List<String>>{
  new List<String>{'rck-drone-setup-71','RC: Quick fix: Binding FPV goggles to a drone VTX','Drones / Setup & Getting Started: I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?','<h2>Binding FPV goggles to a drone VTX</h2><p><b>Problem.</b> I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p><b>Applies to.</b> Drones — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol>','Drones','Setup & Getting Started','<p>I cannot get video in my FPV goggles. How do I set the channel and bind the VTX?</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the goggles and VTX to the same band and channel.</li><li>Confirm the VTX has an antenna attached before powering on.</li><li>Start on low transmit power indoors.</li><li>Scan channels in the goggles if the picture is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-broken-72','RC: One drone motor does not spin on arming','Drones / Something Is Broken: When I arm my quad, one motor stays silent. The others spin fine.','<h2>One drone motor does not spin on arming</h2><p><b>Problem.</b> When I arm my quad, one motor stays silent. The others spin fine.</p><p><b>Applies to.</b> Drones — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol>','Drones','Something Is Broken','<p>When I arm my quad, one motor stays silent. The others spin fine.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-broken-73','RC: Beginner guide: One drone motor does not spin on arming','Drones / Something Is Broken: When I arm my quad, one motor stays silent. The others spin fine.','<h2>One drone motor does not spin on arming</h2><p><b>Problem.</b> When I arm my quad, one motor stays silent. The others spin fine.</p><p><b>Applies to.</b> Drones — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol>','Drones','Something Is Broken','<p>When I arm my quad, one motor stays silent. The others spin fine.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-broken-74','RC: Quick fix: One drone motor does not spin on arming','Drones / Something Is Broken: When I arm my quad, one motor stays silent. The others spin fine.','<h2>One drone motor does not spin on arming</h2><p><b>Problem.</b> When I arm my quad, one motor stays silent. The others spin fine.</p><p><b>Applies to.</b> Drones — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol>','Drones','Something Is Broken','<p>When I arm my quad, one motor stays silent. The others spin fine.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check the motor, its ESC, and the solder joints.</li><li>Swap the motor to a known-good output to isolate the fault.</li><li>Inspect the flight controller motor output.</li><li>Re-flash or re-map motors if a signal is missing.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-perf-75','RC: Drone drifts and will not hold position','Drones / Performance & Tuning: My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?','<h2>Drone drifts and will not hold position</h2><p><b>Problem.</b> My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p><b>Applies to.</b> Drones — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol>','Drones','Performance & Tuning','<p>My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-perf-76','RC: Beginner guide: Drone drifts and will not hold position','Drones / Performance & Tuning: My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?','<h2>Drone drifts and will not hold position</h2><p><b>Problem.</b> My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p><b>Applies to.</b> Drones — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol>','Drones','Performance & Tuning','<p>My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-perf-77','RC: Quick fix: Drone drifts and will not hold position','Drones / Performance & Tuning: My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?','<h2>Drone drifts and will not hold position</h2><p><b>Problem.</b> My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p><b>Applies to.</b> Drones — Performance &amp; Tuning.</p><p><b>Resolution.</b></p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol>','Drones','Performance & Tuning','<p>My quad drifts in GPS hold and sometimes circles. Do I need to recalibrate?</p><p>This is a common <b>Performance &amp; Tuning</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Recalibrate the compass away from metal.</li><li>Check the GPS lock quality before flying.</li><li>Level-calibrate the accelerometer on a flat surface.</li><li>Update firmware if drift persists.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-parts-78','RC: Choosing replacement motors and props for a drone','Drones / Parts & Compatibility: I need new motors and props for my quad. How do I pick compatible ones?','<h2>Choosing replacement motors and props for a drone</h2><p><b>Problem.</b> I need new motors and props for my quad. How do I pick compatible ones?</p><p><b>Applies to.</b> Drones — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the motor size and KV to your frame.</li><li>Pair the prop size to the motor.</li><li>Confirm prop rotation for each arm.</li><li>Keep the all-up weight within the frame&#x27;s range.</li></ol>','Drones','Parts & Compatibility','<p>I need new motors and props for my quad. How do I pick compatible ones?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the motor size and KV to your frame.</li><li>Pair the prop size to the motor.</li><li>Confirm prop rotation for each arm.</li><li>Keep the all-up weight within the frame&#x27;s range.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-parts-79','RC: Beginner guide: Choosing replacement motors and props for a drone','Drones / Parts & Compatibility: I need new motors and props for my quad. How do I pick compatible ones?','<h2>Choosing replacement motors and props for a drone</h2><p><b>Problem.</b> I need new motors and props for my quad. How do I pick compatible ones?</p><p><b>Applies to.</b> Drones — Parts &amp; Compatibility.</p><p><b>Resolution.</b></p><ol><li>Match the motor size and KV to your frame.</li><li>Pair the prop size to the motor.</li><li>Confirm prop rotation for each arm.</li><li>Keep the all-up weight within the frame&#x27;s range.</li></ol>','Drones','Parts & Compatibility','<p>I need new motors and props for my quad. How do I pick compatible ones?</p><p>This is a common <b>Parts &amp; Compatibility</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Match the motor size and KV to your frame.</li><li>Pair the prop size to the motor.</li><li>Confirm prop rotation for each arm.</li><li>Keep the all-up weight within the frame&#x27;s range.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-warranty-80','RC: Warranty claim for a dead drone motor','Drones / Returns & Warranty: A motor on my drone died. Can I claim warranty?','<h2>Warranty claim for a dead drone motor</h2><p><b>Problem.</b> A motor on my drone died. Can I claim warranty?</p><p><b>Applies to.</b> Drones — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the flight that caused it.</li><li>Crash damage is typically not covered.</li><li>Include the flight log if you have one.</li></ol>','Drones','Returns & Warranty','<p>A motor on my drone died. Can I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the flight that caused it.</li><li>Crash damage is typically not covered.</li><li>Include the flight log if you have one.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-warranty-81','RC: Beginner guide: Warranty claim for a dead drone motor','Drones / Returns & Warranty: A motor on my drone died. Can I claim warranty?','<h2>Warranty claim for a dead drone motor</h2><p><b>Problem.</b> A motor on my drone died. Can I claim warranty?</p><p><b>Applies to.</b> Drones — Returns &amp; Warranty.</p><p><b>Resolution.</b></p><ol><li>Provide your order number and photos.</li><li>Describe the flight that caused it.</li><li>Crash damage is typically not covered.</li><li>Include the flight log if you have one.</li></ol>','Drones','Returns & Warranty','<p>A motor on my drone died. Can I claim warranty?</p><p>This is a common <b>Returns &amp; Warranty</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Provide your order number and photos.</li><li>Describe the flight that caused it.</li><li>Crash damage is typically not covered.</li><li>Include the flight log if you have one.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-else-82','RC: Pre-flight checklist for a drone','Drones / Something Else: What should I check before each drone flight?','<h2>Pre-flight checklist for a drone</h2><p><b>Problem.</b> What should I check before each drone flight?</p><p><b>Applies to.</b> Drones — Something Else.</p><p><b>Resolution.</b></p><ol><li>Check props, battery, and failsafe.</li><li>Confirm a solid GPS lock if using position hold.</li><li>Fly in open space away from people.</li><li>Verify the return-to-home point is set.</li></ol>','Drones','Something Else','<p>What should I check before each drone flight?</p><p>This is a common <b>Something Else</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check props, battery, and failsafe.</li><li>Confirm a solid GPS lock if using position hold.</li><li>Fly in open space away from people.</li><li>Verify the return-to-home point is set.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-drone-else-83','RC: Beginner guide: Pre-flight checklist for a drone','Drones / Something Else: What should I check before each drone flight?','<h2>Pre-flight checklist for a drone</h2><p><b>Problem.</b> What should I check before each drone flight?</p><p><b>Applies to.</b> Drones — Something Else.</p><p><b>Resolution.</b></p><ol><li>Check props, battery, and failsafe.</li><li>Confirm a solid GPS lock if using position hold.</li><li>Fly in open space away from people.</li><li>Verify the return-to-home point is set.</li></ol>','Drones','Something Else','<p>What should I check before each drone flight?</p><p>This is a common <b>Something Else</b> issue for <b>Drones</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Check props, battery, and failsafe.</li><li>Confirm a solid GPS lock if using position hold.</li><li>Fly in open space away from people.</li><li>Verify the return-to-home point is set.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-setup-84','RC: Choosing charger settings for a new LiPo pack','Other / Setup & Getting Started: I just bought a new LiPo and need the right charger settings so I do not damage it.','<h2>Choosing charger settings for a new LiPo pack</h2><p><b>Problem.</b> I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p><b>Applies to.</b> Other — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol>','Other','Setup & Getting Started','<p>I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-setup-85','RC: Beginner guide: Choosing charger settings for a new LiPo pack','Other / Setup & Getting Started: I just bought a new LiPo and need the right charger settings so I do not damage it.','<h2>Choosing charger settings for a new LiPo pack</h2><p><b>Problem.</b> I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p><b>Applies to.</b> Other — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol>','Other','Setup & Getting Started','<p>I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-setup-86','RC: Quick fix: Choosing charger settings for a new LiPo pack','Other / Setup & Getting Started: I just bought a new LiPo and need the right charger settings so I do not damage it.','<h2>Choosing charger settings for a new LiPo pack</h2><p><b>Problem.</b> I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p><b>Applies to.</b> Other — Setup &amp; Getting Started.</p><p><b>Resolution.</b></p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol>','Other','Setup & Getting Started','<p>I just bought a new LiPo and need the right charger settings so I do not damage it.</p><p>This is a common <b>Setup &amp; Getting Started</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Set the chemistry to LiPo and the cell count to match the pack.</li><li>Charge at 1C unless the pack is rated for more.</li><li>Always balance charge.</li><li>Charge in a fireproof bag or container.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-broken-87','RC: LiPo battery will not charge','Other / Something Is Broken: My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.','<h2>LiPo battery will not charge</h2><p><b>Problem.</b> My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p><b>Applies to.</b> Other — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol>','Other','Something Is Broken','<p>My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-broken-88','RC: Beginner guide: LiPo battery will not charge','Other / Something Is Broken: My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.','<h2>LiPo battery will not charge</h2><p><b>Problem.</b> My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p><b>Applies to.</b> Other — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol>','Other','Something Is Broken','<p>My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'},
  new List<String>{'rck-gen-broken-89','RC: Quick fix: LiPo battery will not charge','Other / Something Is Broken: My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.','<h2>LiPo battery will not charge</h2><p><b>Problem.</b> My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p><b>Applies to.</b> Other — Something Is Broken.</p><p><b>Resolution.</b></p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol>','Other','Something Is Broken','<p>My LiPo pack stopped charging. The charger shows a connection error and one cell reads very low.</p><p>This is a common <b>Something Is Broken</b> issue for <b>Other</b>. Work through the resolution steps in order; the most likely cause is usually the first one.</p>','<p>Follow these steps:</p><ol><li>Inspect and reseat the balance lead.</li><li>Measure per-cell voltage; a 0.0V cell is damaged.</li><li>Never charge a hot or puffed pack.</li><li>Retire and recycle a damaged pack safely.</li></ol><p>If the problem persists after these steps, create a support case and include what you have already tried.</p>'}
};
Integer created = 0, published = 0;
List<String> pubIds = new List<String>();
for (List<String> a : rows) {
  Knowledge__kav kav = new Knowledge__kav(Title=a[1], UrlName=a[0], Summary=a[2],
    Article_Body__c=a[3], Vehicle_Category__c=a[4], Problem_Type__c=a[5],
    Description__c=a[6], Solution__c=a[7], Language='en_US');
  insert kav; created++;
  Knowledge__kav d = [SELECT KnowledgeArticleId FROM Knowledge__kav WHERE Id=:kav.Id LIMIT 1];
  pubIds.add(d.KnowledgeArticleId);
}
for (String id : pubIds) { try { KbManagement.PublishingService.publishArticle(id, true); published++; } catch(Exception e){ System.debug('pub fail '+e.getMessage()); } }
System.debug('ARTICLES batch 5/6: created '+created+' published '+published);
