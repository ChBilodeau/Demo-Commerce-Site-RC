// Each row: [ slug, title, summary, bodyHtml, vehicleCategory, problemType ]
List<List<String>> arts = new List<List<String>>{
  new List<String>{'rck-car-setup-0-0','RC: Binding your radio to the receiver (1/10 scale RC car or truck)','Cars & Trucks / Setup & Getting Started: binding your radio to the receiver. Step-by-step guidance for 1/10 scale models.','<h2>Binding your radio to the receiver</h2><p>Applies to 1/10 scale RC car or truck models. Category: Cars &amp; Trucks. Problem type: Setup &amp; Getting Started.</p><ol><li>Power the receiver and enter bind mode (bind plug or button).</li><li>Hold the transmitter bind button while switching it on.</li><li>Wait for the receiver LED to go solid, then power cycle both.</li></ol>','Cars & Trucks','Setup & Getting Started'},
