Integer created = 0, published = 0;
List<String> publishIds = new List<String>();
for (List<String> a : arts) {
  Knowledge__kav kav = new Knowledge__kav(
    Title = a[1], UrlName = a[0], Summary = a[2], Article_Body__c = a[3],
    Vehicle_Category__c = a[4], Problem_Type__c = a[5], Language = 'en_US'
  );
  insert kav; created++;
  Knowledge__kav draft = [SELECT Id, KnowledgeArticleId FROM Knowledge__kav WHERE Id = :kav.Id LIMIT 1];
  publishIds.add(draft.KnowledgeArticleId);
}
for (String kaId : publishIds) {
  try { KbManagement.PublishingService.publishArticle(kaId, true); published++; }
  catch (Exception e) { System.debug('Publish failed for ' + kaId + ': ' + e.getMessage()); }
}
System.debug('Batch 3/10: created ' + created + ', published ' + published + '.');
